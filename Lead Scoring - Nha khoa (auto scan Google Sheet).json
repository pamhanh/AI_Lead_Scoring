      "parameters": {
        "jsCode": "// Chuẩn hoá domain từ cột website để dùng làm khoá dedupe + gọi API\nconst out = [];\nfor (const item of $input.all()) {\n  let url = (item.json.website || '').toString().trim();\n  let domain = url\n    .replace(/^https?:\\/\\//i, '')\n    .replace(/^www\\./i, '')\n    .split('/')[0]\n    .toLowerCase();\n  item.json.domain = domain;\n  out.push(item);\n}\nreturn out;"
      },
